# ==============================================================================
# Albert Professional Email Automation — Configuration
# ==============================================================================

# 1. Target Subdomain Configuration
TARGET_SUBDOMAIN=albert
PROVIDER_DOMAIN=does.software
PREFERRED_ALIAS=hello

# 2. Forwarding Destination (Personal Gmail)
# NEVER commit your real email password or personal credentials to Git!
# Incoming emails to hello@albert.does.software will be routed here:
PERSONAL_FORWARD_EMAIL=albertkalampadan@gmail.com

# 3. Portfolio Web Redirect (Destination for web visitors to albert.does.software)
TARGET_REDIRECT_URL=https://albert-linson-platform.albertkalampadan.workers.dev

# 4. Local Dashboard Server (Security: Bound to 127.0.0.1 by default)
PORT=3050
HOST=127.0.0.1

# 5. Autonomous Availability Engine
AUTO_MONITOR_INTERVAL_SECONDS=60
ENABLE_BACKGROUND_MONITOR=true

# 6. Optional Google OAuth for Automated Gmail Confirmation Detection
# (Uses least-privilege scope: https://www.googleapis.com/auth/gmail.readonly)
# Leave blank to use one-click confirmation link / manual token paste fallback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# 7. Security & Verification Tokens (Populated after receiving provider confirmation)
CONFIRMATION_TOKEN=
RENEWAL_TOKEN=
SUBDOMAIN_ID=
LEASE_START_DATE=

# 8. Alternative Provider Reference (Forward Email / Cloudflare)
USE_ALTERNATIVE_PROVIDER=false
FORWARD_EMAIL_API_KEY=
