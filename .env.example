# ========================================================
# ALBERT LINSON PERSONAL INTELLIGENCE PLATFORM
# Environment Configuration Template
# ========================================================

# Application
ENVIRONMENT=development
PORT=3000
BACKEND_PORT=8050
NEXT_PUBLIC_APP_NAME="Albert Linson Personal Intelligence Platform"
NEXT_PUBLIC_SITE_URL="https://albertlinson.com"

# Database Configuration (SQLite Local / D1 Edge)
DATABASE_URL="sqlite:///apps/backend/data/atsforge.db"

# OpenRouter AI Gateway (Prioritizing 100% Free Models)
# Sign up at: https://openrouter.ai/
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_FALLBACK_MODEL="google/gemini-2.0-flash-exp:free"

# Optional Secondary AI Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Cloudflare Deployment Secrets (For GitHub Actions & Wrangler)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
