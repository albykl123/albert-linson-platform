# ==============================================================================
# ALBERT LINSON PERSONAL INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# This template defines all required and optional environment variables.
# NEVER commit .env or secrets to Git.
#
# SECTIONS:
# 1. Local Development Variables (.env.local)
# 2. Public Frontend Configuration (NEXT_PUBLIC_*)
# 3. Server-Side Authentication & Security Secrets
# 4. OpenRouter AI Gateway (Free Tier Prioritization)
# 5. Cloudflare Workers & Pages Deployment Secrets
# 6. Cloudflare D1 & R2 Resource Identifiers
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT CONFIGURATION (.env.local)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=3000
BACKEND_PORT=8050
DATABASE_URL="sqlite:///apps/backend/data/atsforge.db"

# ------------------------------------------------------------------------------
# 2. PUBLIC FRONTEND CONFIGURATION (Safe for Client Bundles)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Albert Linson Personal Intelligence Platform"
NEXT_PUBLIC_SITE_URL="https://albertlinson.com"

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE AUTHENTICATION & SECURITY SECRETS (SERVER ONLY - NEVER EXPOSE)
# ------------------------------------------------------------------------------
# Passcode used to unlock /admin studio (Set a strong private secret for production)
ADMIN_SECRET_KEY="replace_with_strong_private_admin_passcode"
# Secret for signing session cookies
SESSION_SECRET="replace_with_32_char_random_signing_key"

# ------------------------------------------------------------------------------
# 4. OPENROUTER AI GATEWAY (SERVER ONLY - NEVER EXPOSE)
# ------------------------------------------------------------------------------
# Obtain your free API key at: https://openrouter.ai/
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Default to 100% free multi-model routing
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_FALLBACK_MODEL="google/gemini-2.0-flash-exp:free"

# Optional Secondary AI Providers (Local or Direct API)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE SECRETS (Configure in GitHub Actions Secrets & Cloudflare Dashboard)
# ------------------------------------------------------------------------------
# GitHub Actions Secrets: Settings -> Secrets and variables -> Actions
# CLOUDFLARE_API_TOKEN   (Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token with Workers/Pages Edit)
# CLOUDFLARE_ACCOUNT_ID  (Cloudflare Dashboard -> Workers & Pages -> Account ID from right sidebar)
# OPENROUTER_API_KEY     (Your OpenRouter API Key for automated deployment runtime)
# ADMIN_SECRET_KEY       (Your private admin studio access passcode)

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE D1 & R2 RESOURCE IDENTIFIERS (wrangler.toml bindings)
# ------------------------------------------------------------------------------
# Run: npx wrangler d1 create albert-linson-db
# D1 Database Name: albert-linson-db
# D1 Binding Name: DB
#
# Run: npx wrangler r2 bucket create albert-linson-resumes
# R2 Bucket Name: albert-linson-resumes
# R2 Binding Name: RESUME_STORAGE
